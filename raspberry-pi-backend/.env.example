# Raspberry Pi Backend Configuration
# Copy this file to .env and customize paths as needed

# Script paths (optional - defaults to ./scripts/category/script.py relative to backend dir)
# PI_SCRIPT_YANDEX_START_VPS=/custom/path/to/start_vps.py
# PI_SCRIPT_YANDEX_STATUS=/custom/path/to/check_status.py
# PI_SCRIPT_JELLYFIN_STATUS=/custom/path/to/check_status.py
# PI_SCRIPT_JELLYFIN_LOGS=/custom/path/to/get_logs.py
# PI_SCRIPT_JELLYFIN_RESTART=/custom/path/to/restart.py

# Disk monitoring
PI_DISK_MOUNT_POINTS=/,/boot/firmware,/mnt/SSD4TB/D
PI_DISK_LABELS=/:Системный диск,/boot/firmware:Boot раздел,/mnt/SSD4TB/D:SSD 4TB Данные
PI_DISK_DEVICE_PATTERN=mmcblk0p[12]|sd[a-z]+\d+

# Yandex Cloud
YANDEX_INSTANCE_ID=fhm1234abcd5678efgh
PI_YC_PATH=/usr/local/bin/yc

# Jellyfin
PI_JELLYFIN_LOG_PATH=/var/log/jellyfin/jellyfin.log
PI_JELLYFIN_CACHE_PATH=/var/cache/jellyfin
